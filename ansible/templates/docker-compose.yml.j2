version: '3.8'

services:
  db:
    image: postgres:15-alpine
    container_name: project1-db
    environment:
      POSTGRES_DB: "{{ db_name }}"
      POSTGRES_USER: "{{ db_user }}"
      POSTGRES_PASSWORD: "{{ db_password }}"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - {{ repo_root }}/postgres/init.sql:/docker-entrypoint-initdb.d/init.sql
    ports:
      - "5432:5432"
    networks:
      - project1-network

  backend:
    build:
      context: {{ repo_root }}/backend
    container_name: project1-backend
    environment:
      DB_HOST: db
      DB_NAME: "{{ db_name }}"
      DB_USER: "{{ db_user }}"
      DB_PASS: "{{ db_password }}"
      HOST: 0.0.0.0
    ports:
      - "5001:5001"
    depends_on:
      - db
    networks:
      - project1-network

  nginx:
    image: nginx:alpine
    container_name: project1-nginx
    ports:
      - "{{ nginx_port }}:80"
    volumes:
      - {{ repo_root }}/frontend:/usr/share/nginx/html
      - {{ repo_root }}/nginx/nginx.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - backend
    networks:
      - project1-network

volumes:
  pgdata:

networks:
  project1-network:
    name: project1-network